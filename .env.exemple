# Copier en .env et remplir. Le fichier .env n'est jamais versionne.

# API directe Anthropic (Claude Opus 5)
ANTHROPIC_API_KEY=

# OpenRouter (les douze autres modeles)
OPENROUTER_API_KEY=

# Facultatif : forcer l'identifiant fournisseur d'un modele sans toucher au code.
# Format : NARCISSUS_ID_<CLE EN MAJUSCULES, TIRETS ET POINTS EN SOULIGNES>
# Exemple : NARCISSUS_ID_GPT_5_6_SOL=openai/gpt-5.6-sol
