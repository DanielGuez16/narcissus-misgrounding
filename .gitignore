# --- Cles d'API et secrets ---
.env
.env.*
!.env.exemple
*.key
*.pem
secrets/
cles/

# --- Environnements virtuels ---
.venv/
venv/
env/
ENV/

# --- Caches Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Resultats bruts (volumineux, versionnes a la publication) ---
resultats/brut/*
!resultats/brut/.gitkeep

# --- Calibrage apres correction (bruts + lecture, non versionnes) ---
resultats/calibrage_apres_correction/
resultats/calibrage_apres_correction_LECTURE.md

# --- Calibrage avant correction (premier calibrage, non versionne) ---
resultats/calibrage_avant_correction/

# --- Codage (volumineux, non versionne a ce stade) ---
resultats/codage/*
!resultats/codage/.gitkeep
resultats/codage_calibrage/
resultats/codage_calibrage3/
resultats/echecs_codage.jsonl

# --- Journaux d'execution ---
resultats/echecs*.jsonl

